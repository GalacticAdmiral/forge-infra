r_name _;\n        return 444;\n    }\n\n    server {\n        listen 443 ssl default_server;\n        server_name _;\n        ssl_certificate     /etc/nginx/ssl/nginx.crt;\n        ssl_certificate_key /etc/nginx/ssl/nginx.key;\n        return 444;\n    }\n\n    # Upstream - k3s nodes\n    upstream k3s_cluster {\n        server k3d-forge-agent-0:30080 max_fails=1 fail_timeout=5s;\n        server k3d-forge-agent-0:30080 max_fails=1 fail_timeout=5s;\n    }\n\n    # HTTP -\u003e HTTPS redirect\n    server {\n        listen 80;\n        server_name forge.mechanicus.local;\n        return 301 https://$host$request_uri;\n    }\n\n    # Main HTTPS server\n    server {\n        listen 443 ssl;\n        server_name forge.mechanicus.local;\n\n        ssl_certificate     /etc/nginx/ssl/nginx.crt;\n        ssl_certificate_key /etc/nginx/ssl/nginx.key;\n        ssl_protocols       TLSv1.2 TLSv1.3;\n\n        access_log /var/log/nginx/access.log;\n        error_log  /var/log/nginx/error.log;\n\n        location / {\n            # IP allow list\n            #allow 127.0.0.1;\n            #allow 172.16.0.0/12;\n            #allow 10.0.0.0/8;\n            #deny all;\n\n            #return 200 \"The Forge stands ready.\\n\";\n            #add_header Content-Type text/plain;\n\n            proxy_pass http://k3s_cluster;\n            proxy_connect_timeout 1s;\n            client_max_body_size 500M;\n            proxy_send_timeout 1800;\n            proxy_read_timeout 1800;\n            send_timeout 1800;\n\n            proxy_set_header Host              $host;\n            proxy_set_header X-Real-IP         $remote_addr;\n            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;\n            proxy_set_header X-Forwarded-Proto $scheme;\n        }\n    }\n}","content_base64":"","executable":false,"file":"/etc/nginx/nginx.conf","permissions":"","source":"","source_hash":""}],"user":"","userns_mode":"","volumes":[],"wait":false,"wait_timeout":60,"working_dir":"/"},"sensiti